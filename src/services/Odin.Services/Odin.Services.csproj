<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(ProjectDir)../../../common-project.props" />
  
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Certes" Version="4.1.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <!-- Pinned above what MailKit/MimeKit 4.17 pull in (8.0.1): GHSA-846f-f764-76mx / CVE-2026-84008,
         .NET DoS, patched in 8.0.2. Drop this once MailKit's own dependency is past the advisory. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="WebPush" Version="1.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../core/Odin.Core.Cryptography/Odin.Core.Cryptography.csproj" />
    <ProjectReference Include="../../core/Odin.Core.Storage/Odin.Core.Storage.csproj" />
    <ProjectReference Include="../../core/Odin.Core/Odin.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DejaVu Sans (Bitstream Vera license, permissive/redistributable; see Fonts/DejaVuSans-LICENSE.txt),
         embedded so InitialsAvatarGenerator can rasterize smooth glyph outlines without an image-library
         dependency. Needs an explicit EmbeddedResource entry since it isn't picked up by default globbing. -->
    <EmbeddedResource Include="Optimization/Cdn/Fonts/DejaVuSans.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- The V2 in-process test framework calls internal members for its test-only drain hooks
         and replacement-factory wiring. Keep this list tight; production never relies on it. -->
    <InternalsVisibleTo Include="Odin.Hosting.Tests.V2" />
    <!-- V1 tests reach two internal test seams: the registry's background-service alignment, which
         a test makes fail once to prove it is retried, and the outbox drain hook, because an item
         deferred by a retry-later answer sits for minutes, which no test can wait out. -->
    <InternalsVisibleTo Include="Odin.Hosting.Tests" />
    <!-- ShardRotationGate's clock, so its cooldown is unit-tested in Release CI. -->
    <InternalsVisibleTo Include="Odin.Services.Tests" />
  </ItemGroup>

</Project>
