<Project>

  <!--
    Legacy BouncyCastle isolation.

    WebPush (through its latest release, 1.0.13) depends on Portable.BouncyCastle 1.9.0, which ships the
    assembly BouncyCastle.Crypto.dll. (Certes did too until 4.x, which moved to
    BouncyCastle.Cryptography.) Our own code uses the current official
    package, BouncyCastle.Cryptography, which ships BouncyCastle.Cryptography.dll.

    Both assemblies expose the same Org.BouncyCastle.* namespaces, so any file using those
    types in a project that also sees WebPush fails to compile with
    CS0433 (type exists in both assemblies).

    Hiding the legacy assembly behind an extern alias makes Org.BouncyCastle.* bind
    unambiguously to the current package. This is compile-time only: BouncyCastle.Crypto.dll
    is still copied to the output and still loaded at runtime by WebPush, which is compiled
    against it.

    Drop this target once WebPush is replaced by a package that references
    BouncyCastle.Cryptography directly.
  -->
  <Target Name="AliasLegacyBouncyCastle" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)' == 'BouncyCastle.Crypto'">
        <Aliases>legacy_bouncycastle</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>

</Project>
